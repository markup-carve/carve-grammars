{
  "name": "@markup-carve/carve-grammars",
  "version": "0.1.24",
  "description": "Carve 0.2 syntax grammars for Prism, highlight.js, TextMate, and Shiki",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:grammar": "node tests/carve-grammar-test.js",
    "test:shiki": "node tests/shiki-blank-lines-test.js",
    "syntax-palette:build": "node scripts/build-syntax-palette.mjs",
    "syntax-palette:check": "node scripts/build-syntax-palette.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markup-carve/carve-grammars.git"
  },
  "keywords": [
    "carve",
    "markup",
    "syntax-highlighting",
    "prism",
    "prismjs",
    "highlight.js",
    "hljs",
    "textmate",
    "shiki"
  ],
  "author": "markup-carve",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/markup-carve/carve-grammars/issues"
  },
  "homepage": "https://github.com/markup-carve/carve-grammars#readme",
  "files": [
    "prism/",
    "highlightjs/",
    "shiki/",
    "themes/",
    "textmate/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./shiki/index.js",
    "./prism/carve.js": "./prism/carve.js",
    "./highlightjs/carve.js": {
      "import": "./highlightjs/carve.mjs",
      "default": "./highlightjs/carve.js"
    },
    "./highlightjs/carve.mjs": "./highlightjs/carve.mjs",
    "./highlightjs/delimited.js": {
      "import": "./highlightjs/delimited.mjs",
      "default": "./highlightjs/delimited.js"
    },
    "./shiki": "./shiki/index.js",
    "./shiki/themes": "./shiki/themes.js",
    "./shiki/carve.css": "./shiki/carve.css",
    "./shiki/table-tokens.css": "./shiki/table-tokens.css",
    "./themes/palette.json": "./themes/palette.json",
    "./themes/carve-code.css": "./themes/carve-code.css",
    "./textmate/carve.tmLanguage.json": "./textmate/carve.tmLanguage.json",
    "./textmate/csv.tmLanguage.json": "./textmate/csv.tmLanguage.json",
    "./textmate/tsv.tmLanguage.json": "./textmate/tsv.tmLanguage.json",
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "peerDependencies": {
    "@shikijs/themes": "^4",
    "highlight.js": "^11",
    "prismjs": "^1"
  },
  "peerDependenciesMeta": {
    "@shikijs/themes": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shikijs/themes": "^4.4.3",
    "highlight.js": "^11.11.1",
    "prismjs": "^1.30.0",
    "shiki": "^4.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
