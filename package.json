{
  "name": "@markup-carve/carve-grammars",
  "version": "0.1.24",
  "description": "Carve 0.2 syntax grammars for Prism, highlight.js, TextMate, and Shiki",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:grammar": "node tests/carve-grammar-test.js",
    "test:shiki": "node tests/shiki-blank-lines-test.js",
    "syntax-palette:build": "node scripts/build-syntax-palette.mjs",
    "syntax-palette:check": "node scripts/build-syntax-palette.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markup-carve/carve-grammars.git"
  },
  "keywords": [
    "carve",
    "markup",
    "syntax-highlighting",
    "prism",
    "prismjs",
    "highlight.js",
    "hljs",
    "textmate",
    "shiki"
  ],
  "author": "markup-carve",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/markup-carve/carve-grammars/issues"
  },
  "homepage": "https://github.com/markup-carve/carve-grammars#readme",
  "files": [
    "diagrams/",
    "prism/",
    "highlightjs/",
    "shiki/",
    "themes/",
    "tiptap/",
    "diff/",
    "textmate/",
    "fence-languages/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./shiki/index.js",
    "./diagrams": "./diagrams/index.js",
    "./diagrams/kroki": "./diagrams/kroki.js",
    "./diagrams/graphviz": "./diagrams/graphviz.js",
    "./diagrams/d2": "./diagrams/d2.js",
    "./diagrams/*": "./diagrams/*",
    "./prism/carve.js": "./prism/carve.js",
    "./prism/*": "./prism/*",
    "./highlightjs/carve.js": {
      "import": "./highlightjs/carve.mjs",
      "default": "./highlightjs/carve.js"
    },
    "./highlightjs/carve.mjs": "./highlightjs/carve.mjs",
    "./highlightjs/delimited.js": {
      "import": "./highlightjs/delimited.mjs",
      "default": "./highlightjs/delimited.js"
    },
    "./highlightjs/*": "./highlightjs/*",
    "./shiki": "./shiki/index.js",
    "./shiki/diff": {
      "types": "./shiki/diff.d.ts",
      "default": "./shiki/diff.js"
    },
    "./shiki/themes": {
      "types": "./shiki/themes.d.ts",
      "default": "./shiki/themes.js"
    },
    "./shiki/carve.css": "./shiki/carve.css",
    "./shiki/table-tokens.css": "./shiki/table-tokens.css",
    "./themes/palette.json": "./themes/palette.json",
    "./themes/carve-code.css": "./themes/carve-code.css",
    "./diff": {
      "types": "./diff/index.d.ts",
      "default": "./diff/index.js"
    },
    "./diff/carve-diff.css": "./diff/carve-diff.css",
    "./textmate/carve.tmLanguage.json": "./textmate/carve.tmLanguage.json",
    "./textmate/csv.tmLanguage.json": "./textmate/csv.tmLanguage.json",
    "./textmate/tsv.tmLanguage.json": "./textmate/tsv.tmLanguage.json",
    "./fence-languages.json": "./fence-languages/fence-languages.json",
    "./tiptap": {
      "types": "./tiptap/index.d.ts",
      "default": "./tiptap/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@shikijs/themes": "^4.4.3"
  },
  "peerDependencies": {
    "@shikijs/types": "^2 || ^3 || ^4",
    "@terrastruct/d2": "^0.1",
    "@tiptap/core": "^2 || ^3",
    "@tiptap/extension-bullet-list": "^2 || ^3",
    "@tiptap/extension-code": "^2 || ^3",
    "@tiptap/extension-code-block": "^2 || ^3",
    "@tiptap/extension-highlight": "^2 || ^3",
    "@tiptap/extension-image": "^2 || ^3",
    "@tiptap/extension-link": "^2 || ^3",
    "@tiptap/extension-list-item": "^2 || ^3",
    "@tiptap/extension-ordered-list": "^2 || ^3",
    "@tiptap/extension-subscript": "^2 || ^3",
    "@tiptap/extension-superscript": "^2 || ^3",
    "@tiptap/extension-table": "^2 || ^3",
    "@tiptap/extension-table-cell": "^2 || ^3",
    "@tiptap/extension-table-header": "^2 || ^3",
    "@tiptap/extension-table-row": "^2 || ^3",
    "@tiptap/extension-task-item": "^2 || ^3",
    "@tiptap/extension-task-list": "^2 || ^3",
    "@tiptap/extension-underline": "^2 || ^3",
    "@tiptap/pm": "^2 || ^3",
    "@tiptap/starter-kit": "^2 || ^3",
    "@viz-js/viz": "^3",
    "highlight.js": "^11",
    "prismjs": "^1"
  },
  "peerDependenciesMeta": {
    "@shikijs/types": {
      "optional": true
    },
    "@terrastruct/d2": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-bullet-list": {
      "optional": true
    },
    "@tiptap/extension-code": {
      "optional": true
    },
    "@tiptap/extension-code-block": {
      "optional": true
    },
    "@tiptap/extension-highlight": {
      "optional": true
    },
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    },
    "@tiptap/extension-list-item": {
      "optional": true
    },
    "@tiptap/extension-ordered-list": {
      "optional": true
    },
    "@tiptap/extension-subscript": {
      "optional": true
    },
    "@tiptap/extension-superscript": {
      "optional": true
    },
    "@tiptap/extension-table": {
      "optional": true
    },
    "@tiptap/extension-table-cell": {
      "optional": true
    },
    "@tiptap/extension-table-header": {
      "optional": true
    },
    "@tiptap/extension-table-row": {
      "optional": true
    },
    "@tiptap/extension-task-item": {
      "optional": true
    },
    "@tiptap/extension-task-list": {
      "optional": true
    },
    "@tiptap/extension-underline": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@viz-js/viz": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@markup-carve/carve": "github:markup-carve/carve-js#a5a7bbd2c474873b82c3cc01bda2e6948adb3473",
    "@shikijs/types": "^4.4.3",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-bullet-list": "^3.34.0",
    "@tiptap/extension-code": "^3.34.0",
    "@tiptap/extension-code-block": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-list-item": "^3.34.0",
    "@tiptap/extension-ordered-list": "^3.34.0",
    "@tiptap/extension-subscript": "^3.34.0",
    "@tiptap/extension-superscript": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-table-cell": "^3.34.0",
    "@tiptap/extension-table-header": "^3.34.0",
    "@tiptap/extension-table-row": "^3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "happy-dom": "^20.10.6",
    "highlight.js": "^11.11.1",
    "prismjs": "^1.30.0",
    "shiki": "^4.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
