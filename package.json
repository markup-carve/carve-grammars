{
  "name": "@markup-carve/carve-grammars",
  "version": "0.1.2",
  "description": "Grammars for the Carve markup language: Tiptap editor kit + serializer, plus Prism, highlight.js and TextMate syntax-highlighting grammars",
  "type": "module",
  "main": "tiptap/index.js",
  "scripts": {
    "test": "node tests/block-battery-test.js && node tests/coverage-test.js && node tests/schema-map-test.js && node tests/snapshot-test.js && node tests/roundtrip-test.js && node tests/serializer-test.js && node tests/tabs-roundtrip-test.js && node tests/parse-test.js && node tests/grammar-test.js && node tests/shiki-test.js && node tests/engine-sweep-test.js && node tests/unclosed-delimiter-test.js && node tests/textmate-sweep-test.js && node tests/kroki-test.js && node tests/client-diagram-test.js",
    "test:coverage": "node tests/coverage-test.js",
    "test:snapshot": "node tests/snapshot-test.js",
    "test:roundtrip": "node tests/roundtrip-test.js",
    "snapshots:update": "UPDATE_SNAPSHOTS=1 node tests/snapshot-test.js",
    "test:schema-map": "node tests/schema-map-test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markup-carve/carve-grammars.git"
  },
  "keywords": [
    "carve",
    "tiptap",
    "prosemirror",
    "wysiwyg",
    "serializer",
    "markup",
    "syntax-highlighting",
    "prism",
    "prismjs",
    "highlight.js",
    "hljs"
  ],
  "author": "markup-carve",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/markup-carve/carve-grammars/issues"
  },
  "homepage": "https://github.com/markup-carve/carve-grammars#readme",
  "files": [
    "tiptap/",
    "diagrams/",
    "prism/",
    "highlightjs/",
    "shiki/",
    "textmate/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./tiptap/index.js",
    "./tiptap": "./tiptap/index.js",
    "./tiptap/*": "./tiptap/*",
    "./diagrams": "./diagrams/index.js",
    "./diagrams/kroki": "./diagrams/kroki.js",
    "./diagrams/graphviz": "./diagrams/graphviz.js",
    "./diagrams/d2": "./diagrams/d2.js",
    "./diagrams/*": "./diagrams/*",
    "./prism/carve.js": "./prism/carve.js",
    "./prism/*": "./prism/*",
    "./highlightjs/carve.js": {
      "import": "./highlightjs/carve.mjs",
      "default": "./highlightjs/carve.js"
    },
    "./highlightjs/*": "./highlightjs/*",
    "./shiki": "./shiki/index.js",
    "./shiki/carve.css": "./shiki/carve.css",
    "./textmate/carve.tmLanguage.json": "./textmate/carve.tmLanguage.json",
    "./tiptap/schema-map.json": "./tiptap/schema-map.json"
  },
  "dependencies": {
    "@markup-carve/carve": "github:markup-carve/carve-js#857e45feaae42b6699d5ef36635d5a6015875b9b"
  },
  "peerDependencies": {
    "@shikijs/themes": "^2 || ^3",
    "@tiptap/core": "^2 || ^3",
    "@tiptap/extension-underline": "^2 || ^3",
    "@tiptap/starter-kit": "^2 || ^3",
    "highlight.js": "^11",
    "prismjs": "^1",
    "@viz-js/viz": "^3",
    "@terrastruct/d2": "^0.1"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/extension-underline": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "@shikijs/themes": {
      "optional": true
    },
    "@viz-js/viz": {
      "optional": true
    },
    "@terrastruct/d2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shikijs/themes": "^3.13.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-bullet-list": "^3.29.2",
    "@tiptap/extension-code-block": "^3.29.2",
    "@tiptap/extension-hard-break": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list-item": "^3.29.2",
    "@tiptap/extension-subscript": "^3.29.2",
    "@tiptap/extension-superscript": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "happy-dom": "^20.10.6",
    "highlight.js": "^11.11.1",
    "prismjs": "^1.30.0",
    "shiki": "^4.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
