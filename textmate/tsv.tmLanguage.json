{
  "name": "TSV (Carve)",
  "scopeName": "text.tsv.carve",
  "patterns": [
    {
      "include": "#header"
    },
    {
      "include": "#records"
    }
  ],
  "repository": {
    "header": {
      "comment": "The first record. Its begin consumes the first field so #records, which starts at a line start, cannot open before the next line; no capture carries patterns, which the IntelliJ TextMate lexer ignores.",
      "begin": "^(?:( *)(\")|([^\\t\\r\\n]+)|(\\t))",
      "beginCaptures": {
        "2": {
          "name": "string.quoted.double.tsv punctuation.definition.string.begin.tsv"
        },
        "3": {
          "name": "string.unquoted.tsv markup.heading.tsv"
        },
        "4": {
          "name": "keyword.operator.separator.tsv"
        }
      },
      "end": "(?=A)(?!A)",
      "patterns": [
        {
          "include": "#records"
        },
        {
          "begin": "\\G(?<=\")",
          "end": "\"(?!\")",
          "endCaptures": {
            "0": {
              "name": "string.quoted.double.tsv punctuation.definition.string.end.tsv"
            }
          },
          "contentName": "string.quoted.double.tsv markup.heading.tsv",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "include": "#header-fields"
        }
      ]
    },
    "records": {
      "begin": "^",
      "end": "(?=A)(?!A)",
      "patterns": [
        {
          "include": "#fields"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "match": "\\t",
          "name": "keyword.operator.separator.tsv"
        },
        {
          "begin": "(?:^ *|(?<=\\t))(\")",
          "beginCaptures": {
            "1": {
              "name": "string.quoted.double.tsv punctuation.definition.string.begin.tsv"
            }
          },
          "end": "\"(?!\")",
          "endCaptures": {
            "0": {
              "name": "string.quoted.double.tsv punctuation.definition.string.end.tsv"
            }
          },
          "contentName": "string.quoted.double.tsv",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "match": "[^\\t\\r\\n]+",
          "name": "string.unquoted.tsv"
        }
      ]
    },
    "header-fields": {
      "patterns": [
        {
          "match": "\\t",
          "name": "keyword.operator.separator.tsv"
        },
        {
          "begin": "(?:^ *|(?<=\\t))(\")",
          "beginCaptures": {
            "1": {
              "name": "string.quoted.double.tsv punctuation.definition.string.begin.tsv"
            }
          },
          "end": "\"(?!\")",
          "endCaptures": {
            "0": {
              "name": "string.quoted.double.tsv punctuation.definition.string.end.tsv"
            }
          },
          "contentName": "string.quoted.double.tsv markup.heading.tsv",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "match": "[^\\t\\r\\n]+",
          "name": "string.unquoted.tsv markup.heading.tsv"
        }
      ]
    },
    "escape": {
      "match": "\"\"",
      "name": "constant.character.escape.tsv"
    }
  }
}
