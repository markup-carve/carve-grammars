{
  "name": "TSV (Carve)",
  "scopeName": "text.tsv.carve",
  "patterns": [
    {
      "include": "#table"
    }
  ],
  "repository": {
    "table": {
      "comment": "The header is the first line captured whole: inside a host fence's while region \\G re-anchors every line, so a first record whose quoted field spans lines gets record scopes instead.",
      "begin": "^(?:(?=(?:[^\"\\r\\n]|\"(?:[^\"\\r\\n]|\"\")*\")*\\r?$)([^\\r\\n]*))?",
      "beginCaptures": {
        "1": {
          "name": "meta.record.header.tsv",
          "patterns": [
            {
              "include": "#header-fields"
            }
          ]
        }
      },
      "end": "(?=A)(?!A)",
      "patterns": [
        {
          "include": "#fields"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "match": "\\t",
          "name": "punctuation.separator.delimiter.tsv"
        },
        {
          "begin": "^[ ]+(?=\")",
          "end": "(?<=\")",
          "patterns": [
            {
              "begin": "(\")",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.string.begin.tsv"
                }
              },
              "end": "\"(?!\")",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.string.end.tsv"
                }
              },
              "name": "string.quoted.double.tsv",
              "patterns": [
                {
                  "match": "\"\"",
                  "name": "constant.character.escape.tsv"
                }
              ]
            }
          ]
        },
        {
          "begin": "(?:(?<=^)|(?<=\\t))(\")",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.tsv"
            }
          },
          "end": "\"(?!\")",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tsv"
            }
          },
          "name": "string.quoted.double.tsv",
          "patterns": [
            {
              "match": "\"\"",
              "name": "constant.character.escape.tsv"
            }
          ]
        },
        {
          "match": "(?<=\")[^\\t\\r\\n]+",
          "name": "invalid.illegal.text-after-quote.tsv"
        },
        {
          "match": "[^\\t\"\\r\\n]+"
        },
        {
          "match": "\"",
          "name": "invalid.illegal.quote-in-unquoted-field.tsv"
        }
      ]
    },
    "header-fields": {
      "patterns": [
        {
          "match": "\\t",
          "name": "punctuation.separator.delimiter.tsv"
        },
        {
          "begin": "^[ ]+(?=\")",
          "end": "(?<=\")",
          "patterns": [
            {
              "begin": "(\")",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.string.begin.tsv"
                }
              },
              "end": "\"(?!\")",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.string.end.tsv"
                }
              },
              "name": "string.quoted.double.tsv",
              "patterns": [
                {
                  "match": "\"\"",
                  "name": "constant.character.escape.tsv"
                }
              ]
            }
          ]
        },
        {
          "begin": "(?:(?<=^)|(?<=\\t))(\")",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.tsv"
            }
          },
          "end": "\"(?!\")",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tsv"
            }
          },
          "name": "string.quoted.double.tsv",
          "patterns": [
            {
              "match": "\"\"",
              "name": "constant.character.escape.tsv"
            }
          ]
        },
        {
          "match": "(?<=\")[^\\t\\r\\n]+",
          "name": "invalid.illegal.text-after-quote.tsv"
        },
        {
          "match": "[^\\t\"\\r\\n]+",
          "name": "markup.heading.tsv"
        },
        {
          "match": "\"",
          "name": "invalid.illegal.quote-in-unquoted-field.tsv"
        }
      ]
    }
  }
}
