    "citation": {
      "comment": "Citation group [@key]; ported from intellij-carve. Citation group: a bracket whose content contains at least one @key and has no (url)/[ref]/{attrs} tail. A leading + signals an integral/in-text citation. Items are ;-separated; each may carry a -/+ prefix and an optional , locator. The @key and the -/+ per-item markers are scoped distinctly, analogous to @mention but inside the citation bracket.",
      "patterns": [
        {
          "name": "markup.citation.carve",
          "comment": "Match the whole citation bracket [+?...@key...] that is NOT followed by (, [, or { (which would make it a link, ref-link, or span). A lookahead for @ inside the brackets discriminates from plain spans and footnote refs.",
          "begin": "(?<!!)(?<![\\\\])(\\[)(\\+)?(?=[^\\]\\n]*@[A-Za-z0-9_][^\\]\\n]*\\](?!\\(|\\[|\\{))",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.citation.begin.carve"
            },
            "2": {
              "name": "keyword.operator.citation.integral.carve"
            }
          },
          "end": "(\\])(?!\\(|\\[|\\{)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.citation.end.carve"
            }
          },
          "patterns": [
            {
              "comment": "Optional -/+ per-item modifier immediately before the @key",
              "name": "keyword.operator.citation.modifier.carve",
              "match": "(?<=^|;|\\[|\\+)\\s*(-)"
            },
            {
              "comment": "@key: citation key with allowed charset [A-Za-z0-9_][A-Za-z0-9_:.#$%&+?<>~/-]*",
              "name": "variable.other.citation.key.carve",
              "match": "@[A-Za-z0-9_][A-Za-z0-9_:.#$%&+?<>~\\/-]*"
            },
            {
              "comment": "Semicolon item separator",
              "name": "punctuation.separator.citation.carve",
              "match": ";"
            }
          ]
        }
      ]
    },
